    "@id" : "https://w3id.org/sml/def#InformationObject"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A permit is a written permission or authorisation delivered by a competent authority, entity, or person, that is legally delegated to allow someone to do something or to go somewhere."
  } ]
}, {
  "@id" : "https://data.digichecks.eu/def/PermitRequest",
