    "@id" : "https://w3id.org/sml/def#InformationObject"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A permit request is a written appeal or application made to obtain official approval for something from a designated authority.\r\nIt is used as the central hub in the permitting process, with, if issued, a checks:Permit as a result."
  } ]
}, {
  "@id" : "https://data.digichecks.eu/def/Project",
