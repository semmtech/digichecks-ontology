    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="https://data.digichecks.eu/def/Allocation">
        <skos:definition xml:lang="en">An explicit relation between subject and requirement that shows that the subject needs to fulfill the stated requirement.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/Decision">
        <skos:definition xml:lang="en">A decision is an activity of making a choice or judgement based on the available resources.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/Document">
        <skos:definition xml:lang="en">A piece of written, printed, or electronic matter that provides information or evidence or that serves as an official record or acts as a reference.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/MachineReadableRule">
        <skos:definition xml:lang="en">A set of instructions or guidelines that are structured in a format that can be easily interpreted and processed by a computer or software program. The term &quot;rule&quot; refers here to checking rules specifically and is not to be confused with inferencing rules for deriving knowledge.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/Parcel">
        <skos:definition xml:lang="en">Any quantity of land capable of being described with such definiteness that its locations and boundaries may be established.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/Permit">
        <skos:definition xml:lang="en">A permit is a written permission or authorisation delivered by a competent authority, entity, or person, that is legally delegated to allow someone to do something or to go somewhere.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/PermitRequest">
        <skos:definition xml:lang="en">A permit request is a written appeal or application made to obtain official approval for something from a designated authority.
It is used as the central hub in the permitting process, with, if issued, a checks:Permit as a result.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/Project">
        <skos:definition xml:lang="en">A temporary process undertaken to solve a well-defined goal or objective with clearly defined start and end times, a set of clearly defined tasks, and a budget.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/Verification">
        <skos:definition xml:lang="en">A Verification is an activity that checks if a subject is compliant with a requirement.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/VerificationMethod">
        <skos:definition xml:lang="en">A set of procedures to check if the subject is compliant with requirement.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/date">
        <skos:definition xml:lang="en">This attribute describes a timing linked to concepts. It may indicate a date when something was submitted, received, checked, has expired, ...</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/decisionOutcome">
        <skos:definition xml:lang="en">Provides a list of possible decision outcomes which impact the permit request.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/hasApplicant">
        <skos:definition xml:lang="en">The Permit request was applied for by an agent.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/hasApprover">
        <skos:definition xml:lang="en">Indicates a relation between a permitRequest and the Approver, a prov:Agent, of the Request. An Approver is a legal entity (e.g., competent authority) or person issuing the permit approval. </skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/hasAsOutput">
        <skos:definition xml:lang="en">Is an involvement in an occurrence that indicates that the involved object has been operated upon by the occurrence.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/hasParcel">
        <skos:definition xml:lang="en">Indicates the link between location and parcel.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/hasPermitRequest">
        <skos:definition xml:lang="en">Indicates the link from a project to a / multiple permit requests.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/hasRecipient">
        <skos:definition xml:lang="en">Indicates a relation between a permit request and the Recipient, a prov:Agent, of the request. A Recipient is a legal entity (e.g., authority) or person in charge of receiving the permit application </skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/hasSource">
        <skos:definition xml:lang="en">Is a relation that indicates the involved object has a origin or source from another object.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/hasUsecase">
        <skos:definition xml:lang="en">Indicates which use case is applicable for a specific project</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/hasVerificationMethod">
        <skos:definition xml:lang="en">Is an association that indicates a method to verify if the verification object has a method linked to it.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isAddressFor">
        <skos:definition xml:lang="en">Relation to check if the address is linked to a location.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isAllocationfor">
        <skos:definition xml:lang="en">Is an association to ensure that the involved object has an allocation to the corresponding requirement.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isCollectedIn">
        <skos:definition xml:lang="en">Is a relation between a single thing and a plurality that indicates that the collected object is element of the collection of objects, under the constraint that the element may not be the same object as the plural object. In other words a collection cannot be an element of itself.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isDecisionFor">
        <skos:definition xml:lang="en">Is a relation indicating the choice or judgment made based on available resources.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isDerivedIn">
        <skos:definition xml:lang="en">Is an association that indicates that the object has been derived in the source object.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isExpressedAs">
        <skos:definition xml:lang="en">Is a relation that determines how an object is represented similar to a target object</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isGeometryOf">
        <skos:definition xml:lang="en">Indicates that a geometry has a location linked to it.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isInputFor">
        <skos:definition xml:lang="en">Indicates that a / multiple verifications where carried out as a foundation for certain decision taken.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isMadeBy">
        <skos:definition xml:lang="en">Is an involvement in an occurrence that indicates that the involved object has a role as performer of the occurrence.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isParcelFor">
        <skos:definition xml:lang="en">Indicates that a parcel is located at a certain location.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isPermitFor">
        <skos:definition xml:lang="en">Indicates the link between a permit and corresponding permit request that are / were made to obtain certain permit</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isPermitForRequest">
        <skos:definition xml:lang="en">Indicates the relation between a permit and the related request for it</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isRequestForPermit">
        <skos:definition xml:lang="en">Indicates the relation between a request and the specific permit it was requesting.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/isVerifiedIn">
        <skos:definition xml:lang="en">Is an association that indicates that the representer object represents the represented object.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/logicalOperator">
        <skos:definition xml:lang="en">Provides the possibility to indicate if certain conditions are complementary (AND) or supplementary (OR).</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/name">
        <skos:definition xml:lang="en">Provides the name/ title for concepts.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/role">
        <skos:definition xml:lang="en">Indicates in what capacity someone/something is linked to a project, permit, ...</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/shallBeCompliantWith">
        <skos:definition xml:lang="en">Is a conceptual requirement for compliancy to a criterion that indicates that a member of the class shall be conformant to a qualitative requirement. Typically an item, story or document of a kind that should be conform to the content of a document.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://data.digichecks.eu/def/wasDescribedBy">
        <skos:definition xml:lang="en">Relation that is used to indicate that a concept was linked to certain resource in the past. this is meant to keep track of different versions of resources, keep history on all links ever made from concept to resource.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/sml/def#Requirement">
        <skos:definition xml:lang="en">A rule that should hold for something, defined via its attributes or relations</skos:definition>
    </rdf:Description>
</rdf:RDF>



