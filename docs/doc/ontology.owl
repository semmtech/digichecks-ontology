<?xml version="1.0"?>
<rdf:RDF xmlns="https://data.digichecks.eu/def/"
     xml:base="https://data.digichecks.eu/def/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:shacl="http://www.w3.org/ns/shacl#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:data-view="http://www.w3.org/2003/g/data-view#">
    <owl:Ontology rdf:about="https://data.digichecks.eu/def/">
        <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <owl:imports rdf:resource="http://www.w3.org/2000/01/rdf-schema#"/>
        <owl:imports rdf:resource="http://www.w3.org/2002/07/owl#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/shacl#"/>
        <owl:imports rdf:resource="https://w3id.org/sml/def#"/>
        <terms:description>The DigiChecks Permit Ontology is a top-level ontology for describing permitting processes, requirements, and verification activities. The ontology is based on the Semantic Modelling and Linking (SML, EN 17632) framework and provides core terminology for DigiChecks services to communicate unambiguously about permitting processes.</terms:description>
        <rdfs:label>Digichecks Ontology</rdfs:label>
    </owl:Ontology>
    


