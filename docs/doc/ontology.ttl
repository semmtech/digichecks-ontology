<http://www.w3.org/2006/vcard/ns#hasAddress> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#actedOnBehalfOf
<http://www.w3.org/ns/prov#actedOnBehalfOf> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#agent
<http://www.w3.org/ns/prov#agent> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#atLocation
<http://www.w3.org/ns/prov#atLocation> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#qualifiedAssociation
<http://www.w3.org/ns/prov#qualifiedAssociation> rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/decisionOutcome
:decisionOutcome rdf:type owl:ObjectProperty ;
                 rdfs:range xsd:enumeration .


###  https://data.digichecks.eu/def/hasApplicant
:hasApplicant rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/hasApprover
:hasApprover rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/hasAsOutput
:hasAsOutput rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/hasParcel
:hasParcel rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/hasPermitRequest
:hasPermitRequest rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/hasRecipient
:hasRecipient rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/hasSource
:hasSource rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/hasUsecase
:hasUsecase rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/hasVerificationMethod
:hasVerificationMethod rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/isAddressFor
:isAddressFor rdf:type owl:ObjectProperty ;
              owl:inverseOf <http://www.w3.org/2006/vcard/ns#hasAddress> .


###  https://data.digichecks.eu/def/isAllocationfor
:isAllocationfor rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/isCollectedIn
:isCollectedIn rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/isDecisionFor
:isDecisionFor rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/isDerivedIn
:isDerivedIn rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/isExpressedAs
:isExpressedAs rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/isGeometryOf
:isGeometryOf rdf:type owl:ObjectProperty ;
              owl:inverseOf <http://www.opengis.net/ont/geosparql#hasGeometry> .


###  https://data.digichecks.eu/def/isInputFor
:isInputFor rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/isMadeBy
:isMadeBy rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/isParcelFor
:isParcelFor rdf:type owl:ObjectProperty ;
             owl:inverseOf :hasParcel .


###  https://data.digichecks.eu/def/isPermitFor
:isPermitFor rdf:type owl:ObjectProperty ;
             owl:inverseOf :isRequestForPermit .


###  https://data.digichecks.eu/def/isPermitForRequest
:isPermitForRequest rdf:type owl:ObjectProperty ;
                    owl:inverseOf :hasPermitRequest .


###  https://data.digichecks.eu/def/isRequestForPermit
:isRequestForPermit rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/isVerifiedIn
:isVerifiedIn rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/logicalOperator
:logicalOperator rdf:type owl:ObjectProperty ;
                 rdfs:range xsd:enumeration .


###  https://data.digichecks.eu/def/result
:result rdf:type owl:ObjectProperty ;
        rdfs:range xsd:enumeration .


###  https://data.digichecks.eu/def/shallBeCompliantWith
:shallBeCompliantWith rdf:type owl:ObjectProperty .


###  https://data.digichecks.eu/def/wasDescribedBy
:wasDescribedBy rdf:type owl:ObjectProperty .


###  https://w3id.org/sml/def#begins
<https://w3id.org/sml/def#begins> rdf:type owl:ObjectProperty .


###  https://w3id.org/sml/def#ends
<https://w3id.org/sml/def#ends> rdf:type owl:ObjectProperty .


###  https://w3id.org/sml/def#executes
<https://w3id.org/sml/def#executes> rdf:type owl:ObjectProperty .


###  https://w3id.org/sml/def#hasBoundary
<https://w3id.org/sml/def#hasBoundary> rdf:type owl:ObjectProperty .


###  https://w3id.org/sml/def#hasPart
<https://w3id.org/sml/def#hasPart> rdf:type owl:ObjectProperty .


###  https://w3id.org/sml/def#hasRequirement
<https://w3id.org/sml/def#hasRequirement> rdf:type owl:ObjectProperty .


###  https://w3id.org/sml/def#hasState
<https://w3id.org/sml/def#hasState> rdf:type owl:ObjectProperty .


###  https://w3id.org/sml/def#hasTemporalEntity
<https://w3id.org/sml/def#hasTemporalEntity> rdf:type owl:ObjectProperty .


###  https://w3id.org/sml/def#transforms
<https://w3id.org/sml/def#transforms> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:string .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:string .


###  https://data.digichecks.eu/def/applicationDate
:applicationDate rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :date ;
                 rdfs:range xsd:date .


###  https://data.digichecks.eu/def/date
:date rdf:type owl:DatatypeProperty ;
      rdfs:range xsd:date .


###  https://data.digichecks.eu/def/decisionOutcome
:decisionOutcome rdf:type owl:DatatypeProperty .


###  https://data.digichecks.eu/def/expirationDate
:expirationDate rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :date ;
                rdfs:range xsd:date .


###  https://data.digichecks.eu/def/issueDate
:issueDate rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :date ;
           rdfs:range xsd:date .


###  https://data.digichecks.eu/def/logicalOperator
:logicalOperator rdf:type owl:DatatypeProperty .


###  https://data.digichecks.eu/def/name
:name rdf:type owl:DatatypeProperty .


###  https://data.digichecks.eu/def/result
:result rdf:type owl:DatatypeProperty .


###  https://data.digichecks.eu/def/role
:role rdf:type owl:DatatypeProperty .


###  https://data.digichecks.eu/def/size
:size rdf:type owl:DatatypeProperty .


###  https://data.digichecks.eu/def/version
:version rdf:type owl:DatatypeProperty ;
         rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/gaia-x/participant#Participant
<http://w3id.org/gaia-x/participant#Participant> rdf:type owl:Class .


###  http://www.opengis.net/ont/geosparql#Geometry
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class .


###  http://www.w3.org/2001/XMLSchema#enumeration
xsd:enumeration rdf:type owl:Class .


###  http://www.w3.org/2006/vcard/ns#Address
<http://www.w3.org/2006/vcard/ns#Address> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://w3id.org/gaia-x/participant#Participant> .


###  http://www.w3.org/ns/prov#Association
<http://www.w3.org/ns/prov#Association> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/sml/def#InformationObject> .


###  http://www.w3.org/ns/shacl#nodeShape
<http://www.w3.org/ns/shacl#nodeShape> rdf:type owl:Class .


###  https://data.digichecks.eu/def/Allocation
:Allocation rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/sml/def#Objectification> .


###  https://data.digichecks.eu/def/Decision
:Decision rdf:type owl:Class ;
          rdfs:subClassOf <https://w3id.org/sml/def#Activity> .


###  https://data.digichecks.eu/def/Document
:Document rdf:type owl:Class ;
          rdfs:subClassOf <https://w3id.org/sml/def#InformationObject> .


###  https://data.digichecks.eu/def/MachineReadableRule
:MachineReadableRule rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/sml/def#AbstractConcept> .


###  https://data.digichecks.eu/def/Parcel
:Parcel rdf:type owl:Class .


###  https://data.digichecks.eu/def/Permit
:Permit rdf:type owl:Class ;
        rdfs:subClassOf <https://w3id.org/sml/def#InformationObject> .


###  https://data.digichecks.eu/def/PermitRequest
:PermitRequest rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/sml/def#InformationObject> .


###  https://data.digichecks.eu/def/Project
:Project rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/sml/def#Entity> .


###  https://data.digichecks.eu/def/ResultValues
:ResultValues rdf:type owl:Class .


###  https://data.digichecks.eu/def/UsecaseValues
:UsecaseValues rdf:type owl:Class .


###  https://data.digichecks.eu/def/Verification
:Verification rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/sml/def#Activity> .


###  https://data.digichecks.eu/def/VerificationMethod
:VerificationMethod rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/sml/def#Activity> .


###  https://data.digichecks.eu/def/decisionOutcomeValues
:decisionOutcomeValues rdf:type owl:Class .


###  https://w3id.org/sml/def#AbstractConcept
<https://w3id.org/sml/def#AbstractConcept> rdf:type owl:Class .


###  https://w3id.org/sml/def#Activity
<https://w3id.org/sml/def#Activity> rdf:type owl:Class .


###  https://w3id.org/sml/def#ConceptType
<https://w3id.org/sml/def#ConceptType> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/sml/def#Type> .


###  https://w3id.org/sml/def#ConcreteConcept
<https://w3id.org/sml/def#ConcreteConcept> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/sml/def#TopConcept> .


###  https://w3id.org/sml/def#Entity
<https://w3id.org/sml/def#Entity> rdf:type owl:Class .


###  https://w3id.org/sml/def#Event
<https://w3id.org/sml/def#Event> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/sml/def#ConcreteConcept> .


###  https://w3id.org/sml/def#GeometricEntity
<https://w3id.org/sml/def#GeometricEntity> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/sml/def#Representation> .


###  https://w3id.org/sml/def#InformationObject
<https://w3id.org/sml/def#InformationObject> rdf:type owl:Class .


###  https://w3id.org/sml/def#Objectification
<https://w3id.org/sml/def#Objectification> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/sml/def#AbstractConcept> .


###  https://w3id.org/sml/def#Representation
<https://w3id.org/sml/def#Representation> rdf:type owl:Class .


###  https://w3id.org/sml/def#Requirement
<https://w3id.org/sml/def#Requirement> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/sml/def#InformationObject> .


###  https://w3id.org/sml/def#TemporalEntity
<https://w3id.org/sml/def#TemporalEntity> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/sml/def#Representation> .


###  https://w3id.org/sml/def#TopConcept
<https://w3id.org/sml/def#TopConcept> rdf:type owl:Class .


###  https://w3id.org/sml/def#Type
<https://w3id.org/sml/def#Type> rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/sml/def#AbstractConcept> .


