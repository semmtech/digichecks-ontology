         rdfs:label "Project" .


###  https://data.digichecks.eu/def/PublicServices
:PublicServices rdf:type owl:NamedIndividual ,
                         :UsecaseValues ;
                rdfs:label "Public services" ;
                <http://www.w3.org/2004/02/skos/core#note> "A building open to the general public with a non-commercial purpose, such as hospitals or schools. " .


###  https://data.digichecks.eu/def/Residential
:Residential rdf:type owl:NamedIndividual ,
                      :UsecaseValues ;
             rdfs:label "Residential" .


###  https://data.digichecks.eu/def/ResultValues
:ResultValues rdf:type owl:NamedIndividual ;
              rdfs:label "Compliance values" .


###  https://data.digichecks.eu/def/UsecaseValues
:UsecaseValues rdf:type owl:NamedIndividual ;
               rdfs:label "Values for the different use cases" .


###  https://data.digichecks.eu/def/Verification
:Verification rdf:type owl:NamedIndividual ;
              rdfs:label "Verification" .


###  https://data.digichecks.eu/def/VerificationMethod
:VerificationMethod rdf:type owl:NamedIndividual ;
                    rdfs:label "Verification method" .


###  https://data.digichecks.eu/def/VerificationShapeOutcomes
:VerificationShapeOutcomes rdf:type owl:NamedIndividual ,
                                    <http://www.w3.org/ns/shacl#nodeShape> ;
                           <http://www.w3.org/ns/shacl#property> _:genid1 ,
                                                                 _:genid3 ;
                           <http://www.w3.org/ns/shacl#targetClass> :Verification .

_:genid1 <http://www.w3.org/ns/shacl#or> [ ] ;
<http://www.w3.org/ns/shacl#path> :hasAsOutput .

_:genid3 <http://www.w3.org/ns/shacl#class> :ResultValues ;
          <http://www.w3.org/ns/shacl#path> :result ;
          <http://www.w3.org/ns/shacl#maxCount> 1 .


