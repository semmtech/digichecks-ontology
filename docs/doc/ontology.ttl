<http://www.w3.org/ns/prov#wasAssociatedWith> rdf:type owl:NamedIndividual .


###  https://data.digichecks.eu/def/Allocation
:Allocation rdf:type owl:NamedIndividual ;
            rdfs:label "Allocation" .


###  https://data.digichecks.eu/def/CheckCompliant
:CheckCompliant rdf:type owl:NamedIndividual ,
                         :ResultValues ;
                rdfs:label "Compliant" .


###  https://data.digichecks.eu/def/CheckNonCompliant
:CheckNonCompliant rdf:type owl:NamedIndividual ,
                            :ResultValues ;
                   rdfs:label "Non compliant" .


###  https://data.digichecks.eu/def/CommercialBuilding
:CommercialBuilding rdf:type owl:NamedIndividual ,
                             :UsecaseValues ;
                    rdfs:label "Commercial building" ;
                    <http://www.w3.org/2004/02/skos/core#editorialNote> "A building open to the general public with a commercial purpose, such as shops." .


###  https://data.digichecks.eu/def/Decision
:Decision rdf:type owl:NamedIndividual ;
          rdfs:label "Decision" .


###  https://data.digichecks.eu/def/Document
